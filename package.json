{
  "name": "schemagine",
  "version": "0.3.0",
  "description": "Schema-driven dynamic form & data management engine for Vue 3",
  "type": "module",
  "license": "MIT",
  "author": "Enicn_d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enicn/schemagine.git"
  },
  "keywords": [
    "vue",
    "schema",
    "dynamic-form",
    "vxe-table",
    "element-plus",
    "low-code"
  ],
  "sideEffects": [
    "dist/*.css"
  ],
  "main": "./dist/schemagine.cjs",
  "module": "./dist/schemagine.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/schemagine.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/schemagine.cjs"
      },
      "default": "./dist/schemagine.mjs"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": {
        "types": "./dist/media/index.d.ts",
        "default": "./dist/media.mjs"
      },
      "require": {
        "types": "./dist/media/index.d.ts",
        "default": "./dist/media.cjs"
      },
      "default": "./dist/media.mjs"
    },
    "./dist/schemagine.css": "./dist/schemagine.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:lib": "vite build --config vite.lib.config.ts && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:p0": "playwright test e2e/p0-engine.spec.ts",
    "test:e2e:ext": "playwright test e2e/p1-engine.spec.ts e2e/p2-engine.spec.ts e2e/batch-e.spec.ts e2e/batch-f.spec.ts e2e/batch-g.spec.ts e2e/batch-h.spec.ts",
    "bench": "playwright test e2e/perf-benchmark.spec.ts",
    "test:e2e:p1": "playwright test e2e/p1-engine.spec.ts",
    "test:e2e:p2": "playwright test e2e/p2-engine.spec.ts",
    "test:e2e:all": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:decoupling": "node scripts/check-decoupling.mjs",
    "lint:docs": "node scripts/check-docs-coverage.mjs",
    "lint:check": "oxlint . && eslint . --cache && node scripts/check-decoupling.mjs && node scripts/check-docs-coverage.mjs",
    "format": "oxfmt src/",
    "gen:schema-docs": "node scripts/generate-schema-docs.run.mjs",
    "prepublishOnly": "pnpm build:lib",
    "prepack": "pnpm build:lib",
    "version": "node -p \"require('./package.json').version\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "mathjs": "^15.2.0"
  },
  "peerDependencies": {
    "element-plus": "^2.13.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "vxe-pc-ui": "^4.13.0",
    "vxe-table": "^4.18.0",
    "xe-utils": "^4.0.0",
    "xlsx": ">=0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "element-plus": "^2.13.7",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "pinia": "^3.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6",
    "vxe-pc-ui": "^4.13.0",
    "vxe-table": "^4.18.13",
    "xe-utils": "^4.0.4",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  }
}
